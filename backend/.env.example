# Discord 봇
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# https://discord.com/developers/applications 의 OAuth2 탭에서 확인
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 웹/쿠키
# 실서비스 도메인 (react-bot.bssm.dev). 이 값과 Discord 개발자 포털의
# OAuth2 Redirect에 등록한 값(WEB_BASE_URL + /auth/discord/callback)이 정확히 일치해야 한다.
WEB_BASE_URL=https://react-bot.bssm.dev
PORT=8000
COOKIE_SECRET=change-me-to-a-random-string
SESSION_MAX_AGE_SECONDS=43200

# discord-bot(Node)과 공유하는 내부 API 키 (양쪽 .env에 동일한 값)
INTERNAL_API_KEY=change-me-to-a-random-string

# 부트스트랩 관리자: 아직 웹 설정에서 운영진 역할을 지정하기 전에도
# 이 디스코드 유저ID들은 항상 관리자 페이지에 접근 가능 (콤마로 구분)
SUPER_ADMIN_DISCORD_IDS=

# DB
DATABASE_URL=sqlite:///./app.db

# 이메일 인증 코드 발송용 SMTP (학교 이메일로 코드 발송)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="RE-ACT 리액트봇 <no-reply@example.com>"
SMTP_USE_TLS=true

VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5

# GitHub 저장소 웹훅 시크릿 (저장소 Settings > Webhooks에 등록한 Secret과 동일한 값)
GITHUB_WEBHOOK_SECRET=
